{
  "name": "sub2video-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint:check": "eslint .",
    "test:ui:interaction": "playwright test .contract.spec.ts",
    "test:ui:layout": "playwright test responsive-layout.contract.spec.ts ui-standards.contract.spec.ts",
    "test:ui:snapshots": "playwright test .visual.spec.ts",
    "test:uat:readonly": "playwright test -c playwright.readonly.config.ts",
    "test:visual": "playwright test",
    "test:integration": "playwright test -c playwright.integration.config.ts",
    "test:visual:update": "playwright test --update-snapshots",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/vue-table": "^8.21.3",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "reka-ui": "^2.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwind-variants": "^0.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^10.10.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
